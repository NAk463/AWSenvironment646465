# docker compose 用の設定。install.sh が .env にコピーします (.env は git 管理外)。

# LocalStack 2026.03 以降は起動に Auth Token が必要です。
# 非商用なら無料の Hobby プランで取得可能: https://app.localstack.cloud
LOCALSTACK_AUTH_TOKEN=

# イメージのバージョン。本番調査の再現性を保つため固定を推奨。
LOCALSTACK_VERSION=latest

# Moto (トークン不要の代替エミュレータ)
MOTO_VERSION=latest

# LocalStack のデバッグログ (1 で有効)
LOCALSTACK_DEBUG=0
